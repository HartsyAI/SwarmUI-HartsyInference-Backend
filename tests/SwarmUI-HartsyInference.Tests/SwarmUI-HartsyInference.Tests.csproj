<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>
    <ItemGroup>
        <!-- Only the path resolvers are compiled here: none has a SwarmUI or engine dependency, so the tests need no SwarmUI build. -->
        <Compile Include="..\..\Generation\FastFramesGenerator.cs" Link="FastFramesGenerator.cs" />
        <Compile Include="..\..\Generation\LongCatAvatarResolver.cs" Link="LongCatAvatarResolver.cs" />
        <Compile Include="..\..\Generation\LongCatVideoResolver.cs" Link="LongCatVideoResolver.cs" />
        <Compile Include="..\..\Generation\MovieRollResolver.cs" Link="MovieRollResolver.cs" />
    </ItemGroup>
</Project>
